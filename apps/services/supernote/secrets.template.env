# Copy to secrets.env (gitignored), fill in, then seal (Fish-safe: pipes only).
# Generate passwords with e.g.:  openssl rand -base64 24 | tr -d '/+=' | head -c 24
#
#   kubectl create secret generic supernote-secrets -n supernote \
#     --from-env-file=secrets.env --dry-run=client -o yaml \
#     | kubeseal --format yaml > sealedsecret-supernote-secrets.yaml
#
# Then uncomment sealedsecret-supernote-secrets.yaml in kustomization.yaml and
# delete secrets.env. Key names below must match supernote.yaml/mariadb.yaml
# (they are secretKeyRef keys, hence the dashes).
mysql-root-password=
mysql-user=supernote
mysql-password=
redis-password=
# Vikunja: Settings -> API Tokens, permissions: tasks create (projects read).
vikunja-token=
